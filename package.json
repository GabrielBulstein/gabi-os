{
  "name": "gabi-os-pixel-office",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/desktop.mjs",
    "gateway": "node server/gateway.mjs",
    "gateway:login": "node server/gateway.mjs --login",
    "gateway:check": "node server/gateway.mjs --check",
    "test:server": "node --test tests/server/*.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
